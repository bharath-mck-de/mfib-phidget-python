# Phidget publisher — copy to .env and edit for this PC.
#   ./scripts/reset.sh          (creates .env from this file if missing)
#   cp .env.example .env        (manual copy)

# ── Change these per workstation ─────────────────────────────────────────────

WORKSTATION=filling-1
DEVICE_ID=filler01

# VINT hub port (0–5) and USB serial — find in Phidget Control Panel
PHIDGET_HUB_PORT=2
PHIDGET_SERIAL=781463

# ── MQTT broker ────────────────────────────────────────────────────────────────

# Local dev: 127.0.0.1   |   Production: central broker IP or hostname
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883

# Leave blank unless your broker requires auth
MQTT_USERNAME=
MQTT_PASSWORD=

# Optional — defaults to phidget-{DEVICE_ID}
MQTT_CLIENT_ID=

# Optional — leave blank to auto-build:
#   mfib/munich/{WORKSTATION}/{DEVICE_ID}/telemetry
MQTT_TOPIC=

# ── Sensor & publisher (defaults usually fine) ─────────────────────────────────

SENSOR_AMPS_OFFSET=2.5
SENSOR_AMPS_VOLTS_RATIO=0.02083
PUBLISH_INTERVAL_MS=1000
PHIDGET_OPEN_TIMEOUT_MS=5000

# ── Logging ───────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO
LOG_FILE=logs/publisher.log
